{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with workout preferences and connected sheet ID",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "athleteName": { "type": "string" },
        "trainerName": { "type": "string" },
        "spreadsheetId": { "type": "string" },
        "currentWeek": { "type": "number" },
        "activeDayId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "WorkoutSession": {
      "title": "WorkoutSession",
      "description": "Completed gym session with exercise sets and weight tracking",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "dayId": { "type": "string" },
        "dayName": { "type": "string" },
        "weekNumber": { "type": "number" },
        "date": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "totalVolumeKg": { "type": "number" },
        "completedSets": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["sessionId", "userId", "dayId", "weekNumber", "date"]
    },
    "BodyMeasurement": {
      "title": "BodyMeasurement",
      "description": "Body measurement entry for tracking physical progress",
      "type": "object",
      "properties": {
        "measurementId": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "weightKg": { "type": "number" },
        "bodyFatPercentage": { "type": "number" },
        "chestCm": { "type": "number" },
        "waistCm": { "type": "number" },
        "armsCm": { "type": "number" },
        "thighsCm": { "type": "number" },
        "shouldersCm": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["measurementId", "userId", "date", "weightKg"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Top-level user profile and sync state"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "WorkoutSession",
      "description": "Workout logs and sets history per user"
    },
    "/users/{userId}/measurements/{measurementId}": {
      "schema": "BodyMeasurement",
      "description": "Body measurements and metrics per user"
    }
  }
}
